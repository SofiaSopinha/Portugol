programa
{
	
	funcao cracha(cadeia nome, cadeia curso , inteiro matricula){
		escreva("------------------------------------------\n")
		escreva("|            CRACHÁ ESTUDANTIL            |\n")
		escreva("------------------------------------------\n")
		escreva("ESTUDANTE: ", nome)
		escreva("\nMATRÍCULA: ", matricula)
		escreva("\nCURSO: ", curso)
		escreva("\n------------------------------------------\n")
		
	}
	funcao inicio(){
		cracha("Ana Luiza do Santos Alvares","Des. de Sistemas", 612010)
		
	
	
	
	}
}
