programa
{
	
	funcao inicio()
	{
		cadeia signos[12] = {"Áries" , "Touro" , "Gêmeos" , "Câncer" , "Leão" , "Virgem" , "Libra" , "Escorpião" , "Sagitário" , "Capricórnio" , "Aquário" , "Peixes"}
		para(inteiro indice = 0; indice < 12; indice++) {
    escreva( signos[indice], "\n")


    //O índice é a posição de uma variável. No exercício acima, o signo de "Touro" equivale ao número 1, Capricórnio ao número 9. 
    //Nesse caso (que vai até 12), as posições vão de 0 à 11.
}

	}
}
